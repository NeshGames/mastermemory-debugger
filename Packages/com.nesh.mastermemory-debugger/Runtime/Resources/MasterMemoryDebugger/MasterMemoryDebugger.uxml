<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Layout only. Every event is bound by MasterMemoryDebuggerController. -->
    <ui:VisualElement name="mm-root" class="mm-debugger" picking-mode="Ignore">
        <ui:VisualElement name="mm-window" class="mm-debugger__window">

            <ui:VisualElement name="mm-header" class="mm-debugger__header">
                <ui:Label text="MasterMemory Runtime Debugger" class="mm-debugger__title" />
                <ui:VisualElement name="mm-tabs" class="mm-debugger__tabs">
                    <ui:Button name="mm-tab-data" text="Data" tooltip="Browse and edit tables" class="mm-debugger__tab" />
                    <ui:Button name="mm-tab-changes" text="Changes" tooltip="Every changed field across all tables" class="mm-debugger__tab" />
                    <ui:Button name="mm-tab-patches" text="Patches" tooltip="Save, apply, merge, import and export patches" class="mm-debugger__tab" />
                    <ui:Button name="mm-tab-validation" text="Validation" tooltip="MasterMemory Validate() failures of the rebuilt database" class="mm-debugger__tab" />
                </ui:VisualElement>
                <ui:VisualElement class="mm-debugger__spacer" />
                <ui:Label name="mm-master-version" class="mm-debugger__header-info" />
                <ui:Label name="mm-override-count" class="mm-debugger__header-info mm-debugger__override-count" />
                <ui:DropdownField name="mm-language" tooltip="Language of the table and field names" class="mm-debugger__language" />
                <ui:Button name="mm-scale-down" text="A-" tooltip="Smaller UI" class="mm-debugger__button mm-debugger__header-button" />
                <ui:Button name="mm-scale-up" text="A+" tooltip="Larger UI" class="mm-debugger__button mm-debugger__header-button" />
                <ui:Button name="mm-close" text="Close" tooltip="Close (F8)" class="mm-debugger__button mm-debugger__header-button" />
            </ui:VisualElement>

            <!-- database viewer layout: tables | records | record detail, both dividers can be dragged -->
            <ui:TwoPaneSplitView name="mm-main" fixed-pane-index="0" fixed-pane-initial-dimension="220" orientation="Horizontal" class="mm-debugger__main">
                <ui:VisualElement name="mm-table-panel" class="mm-debugger__panel mm-debugger__table-panel">
                    <ui:VisualElement class="mm-debugger__table-panel-header">
                        <ui:Label text="Tables" class="mm-debugger__section-title" />
                        <ui:VisualElement class="mm-debugger__spacer" />
                        <ui:Button name="mm-label-template" text="Labels TSV" tooltip="Copy every table and field name as a label template (tab separated) to fill in and load with MasterMemoryDebugLocalization.LoadTsv" class="mm-debugger__button mm-debugger__small-button" />
                    </ui:VisualElement>
                    <ui:TreeView name="mm-table-list" class="mm-debugger__table-list" />
                </ui:VisualElement>

                <ui:TwoPaneSplitView name="mm-data-split" fixed-pane-index="1" fixed-pane-initial-dimension="400" orientation="Horizontal" class="mm-debugger__data-split">
                    <ui:VisualElement name="mm-content-panel" class="mm-debugger__panel mm-debugger__content-panel">
                        <ui:VisualElement name="mm-table-tabs" class="mm-debugger__table-tabs" />
                        <ui:VisualElement name="mm-search-toolbar" class="mm-debugger__search-toolbar">
                            <ui:TextField name="mm-search" class="mm-debugger__search" />
                            <ui:Toggle name="mm-modified-only" label="Modified Only" class="mm-debugger__modified-only" />
                            <ui:Button name="mm-columns" text="Columns ▾" tooltip="Show, hide and freeze columns" class="mm-debugger__button mm-debugger__columns-button" />
                            <ui:Button name="mm-batch-edit" text="Batch Edit…" tooltip="Set, add to or multiply a field of every record that matches the search (one undo step)" class="mm-debugger__button" />
                            <ui:Button name="mm-copy-rows" text="Copy" tooltip="Copy the shown rows and columns as tab separated text (paste into a spreadsheet; WebGL: download)" class="mm-debugger__button" />
                        </ui:VisualElement>
                        <ui:VisualElement name="mm-record-grid" class="mm-debugger__record-list" />
                        <ui:Label name="mm-record-count" class="mm-debugger__record-count" />
                        <ui:VisualElement name="mm-search-completion" class="mm-debugger__completion" />
                        <ui:VisualElement name="mm-columns-popup" class="mm-debugger__columns-popup" />
                    </ui:VisualElement>

                    <ui:VisualElement name="mm-inspector-panel" class="mm-debugger__panel mm-debugger__inspector-panel">
                        <ui:VisualElement class="mm-debugger__inspector-header">
                            <ui:Label name="mm-inspector-title" text="Record Inspector" class="mm-debugger__section-title mm-debugger__inspector-title" />
                            <ui:Label name="mm-record-state" class="mm-debugger__record-state" />
                        </ui:VisualElement>
                        <ui:ScrollView name="mm-inspector" mode="Vertical" class="mm-debugger__inspector" />
                        <ui:VisualElement name="mm-inspector-actions" class="mm-debugger__inspector-actions">
                            <ui:Button name="mm-apply" text="Apply" tooltip="Apply the edits as an override (Enter)" class="mm-debugger__button mm-debugger__button--primary" />
                            <ui:Button name="mm-revert" text="Revert" tooltip="Discard the edits that are not applied" class="mm-debugger__button" />
                            <ui:Button name="mm-reset-record" text="Reset" tooltip="Remove the override of this record" class="mm-debugger__button" />
                            <ui:VisualElement class="mm-debugger__spacer" />
                            <ui:Button name="mm-copy-json" text="Copy JSON" tooltip="Copy the record as JSON (WebGL: download)" class="mm-debugger__button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:TwoPaneSplitView>
            </ui:TwoPaneSplitView>

            <ui:VisualElement name="mm-changes-panel" class="mm-debugger__panel mm-debugger__changes-panel">
                <ui:VisualElement class="mm-debugger__changes-header">
                    <ui:Label text="Changes" class="mm-debugger__section-title" />
                    <ui:Label name="mm-changes-summary" class="mm-debugger__header-info" />
                    <ui:VisualElement class="mm-debugger__spacer" />
                    <ui:Button name="mm-changes-paste" text="Paste TSV…" tooltip="Import values edited in a spreadsheet (the Copy TSV format) as overrides, after a preview" class="mm-debugger__button" />
                    <ui:Button name="mm-changes-copy" text="Copy TSV" tooltip="Copy every changed field (table, key, name, field, original, current) as tab separated text, to paste into a spreadsheet (WebGL: download)" class="mm-debugger__button" />
                </ui:VisualElement>
                <ui:ScrollView name="mm-changes-list" mode="Vertical" class="mm-debugger__changes-list" />
            </ui:VisualElement>

            <!-- built by MasterPatchesController -->
            <ui:VisualElement name="mm-patches-panel" class="mm-debugger__panel mm-debugger__patches-panel" />

            <!-- built by MasterValidationController -->
            <ui:VisualElement name="mm-validation-panel" class="mm-debugger__panel mm-debugger__changes-panel" />

            <ui:ScrollView name="mm-log" mode="Vertical" class="mm-debugger__log" />
            <ui:VisualElement class="mm-debugger__status-row">
                <ui:Label name="mm-status" class="mm-debugger__status" />
                <ui:Button name="mm-undo" text="↶ Undo" tooltip="Undo (Ctrl+Z)" class="mm-debugger__button mm-debugger__log-toggle" />
                <ui:Button name="mm-redo" text="↷ Redo" tooltip="Redo (Ctrl+Y / Ctrl+Shift+Z)" class="mm-debugger__button mm-debugger__log-toggle" />
                <ui:Button name="mm-log-toggle" text="Log" tooltip="Recent messages, warnings and changes" class="mm-debugger__button mm-debugger__log-toggle" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="mm-dialog-layer" class="mm-debugger__dialog-layer" />
    </ui:VisualElement>
</ui:UXML>
